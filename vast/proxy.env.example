# Runtime secrets: do not commit an actual token or ask users to paste it into chat.
VIDEO_PROXY_TOKEN=
VIDEO_PROXY_URL=
# Optional: set this only when this script should start the existing tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
COMFY_DIR=/workspace/ComfyUI
APP_DIR=/workspace/joshbox/vast
COMFY_PYTHON=python3
APP_PYTHON=/workspace/joshbox/.venv/bin/python
JOSHBOX_DATA_DIR=/workspace/joshbox-data
# Comma-separated local model packs. Omit for all five verified catalog entries.
JOSHBOX_MODELS=wan22_5b,wan22_14b,ltx13b,hunyuan15,minimax_h3
# Optional persistent model volume; absent files are linked into COMFY_DIR/models.
# JOSHBOX_MODEL_ROOT=/workspace/persistent/joshbox-models
WORKFLOW_MINIMAX_QUALITY_PATH=
WORKFLOW_MINIMAX_FAST_PATH=
WORKFLOW_WAN14_QUALITY_PATH=
WORKFLOW_WAN14_FAST_PATH=
WORKFLOW_WAN5_QUALITY_PATH=
WORKFLOW_WAN5_FAST_PATH=
WORKFLOW_LTX23_QUALITY_PATH=
WORKFLOW_LTX23_FAST_PATH=
WORKFLOW_LTX13_QUALITY_PATH=
WORKFLOW_LTX13_FAST_PATH=
WORKFLOW_HUNYUAN15_QUALITY_PATH=
WORKFLOW_HUNYUAN15_FAST_PATH=
