# Runtime secrets: do not commit an actual token or ask users to paste it into chat.
VIDEO_PROXY_TOKEN=
COMFY_DIR=/workspace/ComfyUI
APP_DIR=/workspace/joshbox/vast
COMFY_PYTHON=python3
APP_PYTHON=/workspace/joshbox/.venv/bin/python
JOSHBOX_DATA_DIR=/workspace/joshbox-data
WORKFLOW_MINIMAX_QUALITY_PATH=
WORKFLOW_MINIMAX_FAST_PATH=
WORKFLOW_WAN14_QUALITY_PATH=
WORKFLOW_WAN14_FAST_PATH=
WORKFLOW_WAN5_QUALITY_PATH=
WORKFLOW_WAN5_FAST_PATH=
WORKFLOW_LTX23_QUALITY_PATH=
WORKFLOW_LTX23_FAST_PATH=
WORKFLOW_HUNYUAN15_QUALITY_PATH=
WORKFLOW_HUNYUAN15_FAST_PATH=
# Automatic fresh-instance bootstrap (public weights need no HF token):
JOSHBOX_BOOTSTRAP_MODELS=1
JOSHBOX_BOOTSTRAP_PROFILES=wan22-fast,wan22-quality
JOSHBOX_MODEL_DIR=/workspace/joshbox-models
JOSHBOX_MODEL_MANIFEST=/workspace/joshbox/config/models.json
JOSHBOX_BOOT_STATE=/workspace/joshbox-data/bootstrap-state.json
JOSHBOX_MAX_DOWNLOAD_GB=100
# Optional custom/private assets. Use a READ token on the GPU, not an upload token.
HF_ASSETS_REPO=GodofThrones/joshbox-assets
HF_TOKEN=
HF_PRIVATE_MANIFEST=
HF_ASSETS_REVISION=
HF_ASSETS_MANIFEST=config/private-assets.json
# Reserved for future, separately authorized rental automation. Not used today.
VAST_API_KEY=
