# Configure these as protected server runtime values, never in the browser.
COMFY_URL=https://your-authenticated-comfy-endpoint.example
COMFY_TOKEN=
COMFY_AUTH_HEADER=Authorization
# Installed SDXL checkpoint filename (starter image workflow only):
COMFY_CHECKPOINT=
# Optional API-format JSON templates; see README for input placeholders.
COMFY_IMAGE_WORKFLOW=
COMFY_VIDEO_WORKFLOW=
# Optional verified API workflows per mode (override the base video template):
COMFY_VIDEO_WORKFLOW_FAST=
COMFY_VIDEO_WORKFLOW_QUALITY=
# Legacy/current GPU profile (unchanged for existing deployments).
VIDEO_PROXY_URL=
VIDEO_PROXY_TOKEN=
# Optional named GPU profiles. Use authenticated HTTPS tunnels to the *wrapper* only.
# The mobile provider picker selects from these server-side slots; no URL or token is sent to a phone.
VIDEO_PROXY_GCP_URL=
VIDEO_PROXY_GCP_TOKEN=
VIDEO_PROXY_VAST_URL=
VIDEO_PROXY_VAST_TOKEN=

# Start/stop controls for existing GPU instances only; keep all credentials server-side:
GCP_INSTANCE_PROJECT=
GCP_INSTANCE_ZONE=
GCP_INSTANCE_NAME=
GCP_SERVICE_ACCOUNT_JSON=
VAST_INSTANCE_ID=
VAST_API_KEY=
# On each GPU wrapper's *private* environment, separately:
# JOSHBOX_WORKFLOW_CATALOG_PATH=/workspace/joshbox-creative-catalog.json
